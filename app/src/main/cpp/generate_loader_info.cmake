file(STRINGS "${SYMS_FILE}" SYM_LINES)

set(START_HEX "")
set(POKEDATA_HEX "")

foreach(LINE IN LISTS SYM_LINES)
    if(LINE MATCHES "^([0-9a-fA-F]+)[ \t]+[A-Za-z][ \t]+_start$")
        set(START_HEX "${CMAKE_MATCH_1}")
    elseif(LINE MATCHES "^([0-9a-fA-F]+)[ \t]+[A-Za-z][ \t]+pokedata_workaround$")
        set(POKEDATA_HEX "${CMAKE_MATCH_1}")
    endif()
endforeach()

if(NOT START_HEX OR NOT POKEDATA_HEX)
    message(FATAL_ERROR "Failed to locate _start (${START_HEX}) or pokedata_workaround (${POKEDATA_HEX}) in ${SYMS_FILE}")
endif()

math(EXPR OFFSET "0x${POKEDATA_HEX} - 0x${START_HEX}" OUTPUT_FORMAT DECIMAL)

file(WRITE "${OUT_FILE}"
"/* Auto-generated by generate_loader_info.cmake */
#include <unistd.h>
const ssize_t offset_to_pokedata_workaround = ${OFFSET};
")
